[Unit]
Description=Auditoría web: backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/proyectos/auditoria-web/backend
# Un solo proceso: el límite por IP vive en memoria. Solo 127.0.0.1: nunca expuesto a internet.
ExecStart=/home/ubuntu/proyectos/auditoria-web/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
