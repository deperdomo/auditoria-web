# Copia este archivo a .env y rellena los valores.

# Clave gratuita de la API de PageSpeed Insights (Google Cloud > APIs > PageSpeed Insights API).
# Sin clave la herramienta funciona, pero no mide velocidad.
PAGESPEED_API_KEY=

# Token para el panel /admin y para crear informes por lotes. Pon uno largo y aleatorio.
ADMIN_TOKEN=cambia-esto

# Ruta de la base de datos SQLite.
DATABASE_PATH=data/auditoria.db

# Análisis por hora permitidos a una misma IP (visitantes normales).
RATE_LIMIT_PER_HOUR=5

# Horas durante las que se reutiliza el informe de una misma URL.
CACHE_HOURS=24

# true si delante hay un proxy (nginx o Caddy) que añade X-Forwarded-For, como en el servidor.
# Sin proxy delante (en tu ordenador) todas las visitas parecen venir de 127.0.0.1 y comparten
# el mismo límite: sube RATE_LIMIT_PER_HOUR mientras desarrollas.
# No expongas el puerto 8000 a internet: el backend solo debe escuchar en 127.0.0.1.
TRUST_PROXY=true

# Dirección pública del frontend, para los enlaces que genera el script de lotes.
PUBLIC_BASE_URL=http://localhost:3000
